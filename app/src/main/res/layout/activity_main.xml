<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CompLab 2 - Workstation Readiness"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvStationCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PC-07 - Android Studio SDK"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Needs Check"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvStationSpec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Note: Emulator slow to boot"
            android:textSize="14sp"
            android:layout_marginTop="6dp" />

        <Button
            android:id="@+id/btnSwitchStation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Switch Station" />

        <Button
            android:id="@+id/btnInspectStation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Inspect" />

        <Button
            android:id="@+id/btnShareReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Share Status" />

        <Button
            android:id="@+id/btnQuickSupport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quick Support" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activity Lifecycle Logger"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/tvLifecycleLog"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="12dp"
            android:background="#F4F6F9"
            android:padding="12dp"
            android:gravity="top"
            android:text="Lifecycle trace ready..."
            android:textSize="13sp"
            android:scrollbars="vertical" />

        <Button
            android:id="@+id/btnClearLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Clear Log" />

        <Button
            android:id="@+id/btnSimulateTick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Log Check-In Heartbeat" />

    </LinearLayout>

</ScrollView>
